{
  "name": "the-hidden-hand",
  "version": "0.1.0",
  "private": true,
  "description": "The Hidden Hand: steer a living, procedurally generated civilisation from the shadows as a secret order.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').mkdirSync('app',{recursive:true});require('fs').copyFileSync('dist/index.html','app/HiddenHand.html')\"",
    "start": "node launcher/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/cli.ts",
    "validate": "tsx tools/validate.ts",
    "experiment": "tsx tools/experiment.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
