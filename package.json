{
  "name": "the-hidden-hand",
  "version": "0.1.0",
  "private": true,
  "description": "The Hidden Hand: build a secret society in a living Renaissance port city and reshape it from the shadows.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').mkdirSync('app',{recursive:true});require('fs').copyFileSync('dist/index.html','app/HiddenHand.html')\"",
    "start": "node launcher/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "art": "vite --config vite.art.config.ts --open /art.html",
    "build:art": "vite build --config vite.art.config.ts && node tools/artpage.mjs",
    "artshots": "tsx tools/artshots.ts",
    "play": "vite --config vite.play.config.ts --open /play.html",
    "build:play": "vite build --config vite.play.config.ts && node tools/artpage.mjs dist-play dist-play/play.html play-page.html",
    "test:walk": "node tests/e2e/walk.e2e.cjs",
    "test:season": "node tests/e2e/season.e2e.cjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
